#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&mt { flavor = "hold-preferred"; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&to 3>;

            label = "TD1";
        };

        td3: td3 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&none>, <&kp LA(F4)>;

            label = "TD3";
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        alt-tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <32 31>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <1 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "QWERTY";
            bindings = <
&kp TAB               &kp Q  &kp W  &kp E     &kp R         &mt PRINTSCREEN T                                &mmv MOVE_UP                     &kp Y        &kp U        &kp I      &kp O    &kp P     &kp BACKSLASH
&mt LEFT_CONTROL ESC  &kp A  &kp S  &kp D     &kp F         &kp G                            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp H        &kp J        &kp K      &kp L    &kp SEMI  &kp SQT
&td0                  &kp Z  &kp X  &kp C     &kp V         &kp B              &kp C_MUTE                    &mmv MOVE_DOWN                   &kp N        &kp M        &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                    &kp LGUI  &lt 1 DELETE  &kp BACKSPACE                                                                     &lt 4 SPACE  &lt 2 ENTER  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        num {
            display-name = "NUMBER";
            bindings = <
&bt BT_CLR_ALL  &bt BT_CLR  &bt BT_SEL 0               &bt BT_SEL 1        &bt BT_SEL 2                  &bt BT_SEL 3                                &mmv MOVE_UP                     &kp PLUS   &kp N7             &kp N8           &kp N9           &kp ASTRK        &trans
&trans          &kp LCTRL   &mt LEFT_ALT LEFT_BRACKET  &mt LEFT_GUI COMMA  &mt LEFT_SHIFT RIGHT_BRACKET  &trans                      &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &mt LEFT_SHIFT N4  &mt LEFT_GUI N5  &mt LEFT_ALT N6  &mt LCTRL SLASH  &trans
&trans          &trans      &kp LEFT_PARENTHESIS       &trans              &kp RIGHT_PARENTHESIS         &td3          &kp C_MUTE                    &mmv MOVE_DOWN                   &kp EQUAL  &kp N1             &kp N2           &kp N3           &kp PERIOD       &trans
                                                       &trans              &trans                        &trans                                                                       &trans     &kp N0             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        nav {
            display-name = "Navi";
            bindings = <
&trans  &trans     &kp HOME        &kp UP_ARROW    &kp END          &trans                                 &mmv MOVE_UP                     &trans  &trans          &trans          &trans        &trans           &trans
&trans  &trans     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_UP            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &kp LEFT_SHIFT  &kp LEFT_GUI    &kp LEFT_ALT  &kp LCTRL        &trans
&trans  &kp LC(Z)  &kp LC(X)       &kp LC(C)       &kp LC(V)        &kp PG_DN    &trans                    &mmv MOVE_DOWN                   &td3    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
                                   &trans          &td1             &trans                                                                  &trans  &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        media {
            display-name = "Media";
            bindings = <
&studio_unlock  &trans              &kp K_LOCK           &kp C_BRIGHTNESS_DEC       &kp C_BRI_UP         &rgb_ug RGB_TOG                                &mmv MOVE_UP                     &trans  &kp F7  &kp F8  &kp F9  &trans  &sys_reset
&to 0           &mt LCTRL C_REWIND  &mt LEFT_ALT C_STOP  &mt LEFT_GUI C_PLAY_PAUSE  &mt LEFT_SHIFT C_FF  &rgb_ug RGB_EFF                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &kp F4  &kp F5  &kp F6  &trans  &trans
&out OUT_TOG    &trans              &trans               &rgb_ug RGB_BRD            &rgb_ug RGB_BRI      &rgb_ug RGB_HUI  &kp C_MUTE                    &mmv MOVE_DOWN                   &trans  &kp F1  &kp F2  &kp F3  &trans  &trans
                                                         &trans                     &trans               &trans                                                                          &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans     &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans                            &trans          &trans  &trans          &trans          &trans        &trans           &trans
&trans  &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP              &trans  &trans  &trans  &trans  &kp LEFT_SHIFT  &kp LEFT_GUI    &kp LEFT_ALT  &kp LCTRL        &trans
&trans  &kp LG(Z)  &kp LG(X)       &kp LG(C)       &kp LG(V)        &msc SCRL_DOWN  &trans            &trans          &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
                                   &mkp MCLK       &mkp LCLK        &mkp RCLK                                         &trans  &trans          &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
